{
  // Statična stranica posluživana kao Worker s prilozima — bez vlastitog koda.
  // Cloudflare u novom sučelju nudi Workers umjesto Pagesa; ovo je oblik koji
  // taj tok očekuje (`npx wrangler deploy`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zgtransparentnost",
  "compatibility_date": "2026-09-07",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
